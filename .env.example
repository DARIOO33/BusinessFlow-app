# Copy to .env and fill in the values.

# PostgreSQL connection
DATABASE_URL="postgresql://app:app@localhost:5432/businessflow"

# Better Auth: random secret (generate: openssl rand -base64 32)
BETTER_AUTH_SECRET="change-me"
# Public URL of the app (https://www.your-domain.tn in production)
BETTER_AUTH_URL="http://localhost:3000"
